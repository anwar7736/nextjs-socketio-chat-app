# Use MONGODB_URI or the DB_DATABASE / DB_USERNAME / DB_PASSWORD triplet.
MONGODB_URI=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Use the same secret in the Next.js app and Socket-Server. At least 32 characters.
AUTH_SECRET=

# Resend sender must be verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=

# Public Socket.IO URL. For Vercel + VPS, use the VPS HTTPS hostname, e.g.
# https://socket.example.com (not localhost and not the VPS IP on HTTPS).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002

# Optional Web Push notifications. Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional production TURN relay. URLs are comma-separated; credentials are generated per signed-in user.
TURN_URLS=
TURN_SHARED_SECRET=
